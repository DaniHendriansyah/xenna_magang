<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loan_extension_list" model="ir.ui.view">
        <field name="name">equipment.loan.extension.list</field>
        <field name="model">equipment.loan.extension</field>
        <field name="arch" type="xml">
            <list string="Pengajuan Perpanjangan" decoration-info="state == 'pending'">
                <field name="loan_id"/>
                <field name="borrower_id"/>
                <field name="requested_date"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-info="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_loan_extension_form" model="ir.ui.view">
        <field name="name">equipment.loan.extension.form</field>
        <field name="model">equipment.loan.extension</field>
        <field name="arch" type="xml">
            <form string="Detail Pengajuan">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-success" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="loan_id" readonly="state != 'pending'"/>
                        <field name="borrower_id"/>
                        <field name="requested_date" readonly="state != 'pending'"/>
                        <field name="reason" readonly="state != 'pending'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_loan_extension" model="ir.actions.act_window">
        <field name="name">Approval Perpanjangan</field>
        <field name="res_model">equipment.loan.extension</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_loan_extension" name="Request Perpanjangan" parent="menu_equipment_loan_root_new" action="action_loan_extension" sequence="30"/>
</odoo>