<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rule Portal User: Hanya lihat pinjaman miliknya sendiri -->
        <record id="equipment_loan_portal_rule" model="ir.rule">
            <field name="name">Portal User: Own Equipment Loans</field>
            <field name="model_id" ref="model_equipment_loan"/>
            <field name="domain_force">[('borrower_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Rule Portal User: Hanya lihat request perpanjangannya sendiri -->
        <record id="equipment_loan_extension_portal_rule" model="ir.rule">
            <field name="name">Portal User: Own Extensions</field>
            <field name="model_id" ref="model_equipment_loan_extension"/>
            <field name="domain_force">[('borrower_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>