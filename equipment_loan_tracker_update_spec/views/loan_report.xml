<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_loan_update_spec" model="ir.actions.report">
        <field name="name">Cetak Bukti Peminjaman</field>
        <field name="model">equipment.loan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">equipment_loan_tracker_update_spec.report_loan_doc_update</field>
        <field name="report_file">equipment_loan_tracker_update_spec.report_loan_doc_update</field>
    </record>

    <template id="report_loan_doc_update">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mt-4">Bukti Peminjaman Alat</h2>
                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Data Peminjam:</strong>
                                <p class="mb-0">
                                    <span t-field="o.borrower_id.name"/><br/>
                                    <span t-if="o.borrower_phone"><span t-field="o.borrower_phone"/></span><br t-if="o.borrower_phone"/>
                                    <span t-if="o.borrower_email"><span t-field="o.borrower_email"/></span>
                                </p>
                            </div>
                            <div class="col-6">
                                <strong>Status Transaksi:</strong>
                                <p t-field="o.state"/>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered mt-4">
                            <thead>
                                <tr>
                                    <th>Alat yang Dipinjam</th>
                                    <th>Tanggal Pinjam</th>
                                    <th>Jatuh Tempo</th>
                                    <th>Tgl Dikembalikan</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.loan_line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.product_id.name"/></td>
                                        <td><span t-field="o.loan_date"/></td>
                                        <td><span t-field="o.due_date"/></td>
                                        <td><span t-field="o.return_date"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div class="mt-4" t-if="o.line_notes">
                            <strong>Kondisi / Catatan:</strong>
                            <p t-field="o.line_notes"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>