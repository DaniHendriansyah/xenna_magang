<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dashboard_perpustakaan_default" model="dashboard.perpustakaan">
        <field name="name">Dashboard Perpustakaan</field>
    </record>

    <record id="dashboard_perpustakaan_view_list" model="ir.ui.view">
        <field name="name">dashboard.perpustakaan.view.list</field>
        <field name="model">dashboard.perpustakaan</field>
        <field name="arch" type="xml">
            <list string="Dashboard Perpustakaan">
                <field name="total_buku"/>
                <field name="total_siswa"/>
                <field name="sedang_dipinjam"/>
                <field name="terlambat"/>
            </list>
        </field>
    </record>

    <record id="dashboard_perpustakaan_view_form" model="ir.ui.view">
        <field name="name">dashboard.perpustakaan.view.form</field>
        <field name="model">dashboard.perpustakaan</field>
        <field name="arch" type="xml">
            <form string="Dashboard Perpustakaan">
                <sheet>
                    <group>
                        <group>
                            <field name="total_buku"/>
                            <field name="total_siswa"/>
                        </group>

                        <group>
                            <field name="sedang_dipinjam"/>
                            <field name="terlambat"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dashboard_perpustakaan_action" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">dashboard.perpustakaan</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="dashboard_perpustakaan_default"/>
    </record>

    <menuitem id="menu_dashboard_perpustakaan" name="Dashboard" parent="perpustakaan.menu_item_perpustakaan" action="dashboard_perpustakaan_action" sequence="0"/>

</odoo>