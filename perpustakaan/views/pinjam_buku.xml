<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="pinjam_buku_view_list" model="ir.ui.view">
            <field name="name">pinjam_buku_view_list</field>
            <field name="model">pinjam.buku</field>
            <field name="arch" type="xml">
                <list string="Pinjam Buku">
                    <field name="siswa"/>
                    <field name="buku"/>
                    <field name="tanggal_peminjaman"/>
                    <field name="tanggal_pengembalian"/>
                    <field name="status"/>
                    <button name="action_kembalikan_buku" type="object" string="Kembalikan Buku" invisible="status == 'dikembalikan' or status == 'dikembalikan_terlambat'"/>
                </list>
            </field>
        </record>

        <record id="pinjam_buku_view_form" model="ir.ui.view">
            <field name="name">pinjam_buku_view_form</field>
            <field name="model">pinjam.buku</field>
            <field name="arch" type="xml">
                <form string="Pinjam Buku">
                    <sheet>
                        <group>
                            <field name="siswa"/>
                            <field name="buku"/>
                            <field name="tanggal_peminjaman"/>
                            <field name="tanggal_pengembalian"/>
                            <field name="status"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="pinjam_buku_action" model="ir.actions.act_window">
            <field name="name">Pinjam Buku</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pinjam.buku</field>
            <field name="view_mode">list,form</field>
        </record>
        <!-- This Menu Item Must have a parent -->
        <menuitem id="menu_item_pinjam_buku" name="Pinjam Buku" parent="perpustakaan.menu_item_perpustakaan" action="pinjam_buku_action" sequence="1"/>
    </data>
</odoo>